# Ye sab GitHub Secrets mein daalne hain - is file mein NAHI (ye sirf example hai)

GEMINI_API_KEY=your_gemini_key_here
CLAUDE_API_KEY=your_claude_key_here
ETSY_API_KEY=your_etsy_keystring_here
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here

# Google Sheets service account JSON (poora JSON content, ek line mein)
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Google Sheet ka ID (sheet URL mein se, /d/ ke baad wala hissa)
GOOGLE_SHEET_ID=your_sheet_id_here
